<div class="engine" data-id="<%= engine.id %>">
  <button
    class="edit-engine-btn"
    onclick="toggleEditEngine('<%= engine.id %>', '<%= controllerId %>', '<%= ip %>')"
    title="Edit Engine"
  >🖉</button>
  <button
    class="delete-engine-btn"
    onclick="deleteEngine('<%= engine.id %>', '<%= controllerId %>', '<%= ip %>')"
    title="Delete Engine"
  >Delete</button>
  <h3 class="engine-title" id="engine-title-<%= controllerId %>-<%= engine.id %>">
    <span id="engine-display-<%= controllerId %>-<%= engine.id %>">
      <% if (engine.name) { %>
        <%= engine.name %>
      <% } else { %>
        Engine
      <% } %>
    </span>
  </h3>
  <p class="engine-address" id="engine-id-display-<%= controllerId %>-<%= engine.id %>">Address: <%= engine.id %></p>
  <div class="engine-edit" id="engine-edit-<%= controllerId %>-<%= engine.id %>" style="display:none">
    <input
      type="text"
      id="engine-id-<%= controllerId %>-<%= engine.id %>"
      class="engine-id-input"
      value="<%= engine.id %>"
      placeholder="Address"
    />
    <input
      type="text"
      id="engine-name-<%= controllerId %>-<%= engine.id %>"
      class="engine-name-input"
      value="<%= engine.name %>"
      placeholder="Name (optional)"
    />
  </div>

  <div class="speed-group">
    <div class="slider-labels">
      <span>-127</span>
      <span>0</span>
      <span>127</span>
    </div>
    <div class="slider-row">
      <input
        type="range"
        class="slider"
        list="speedmarks"
        min="-127"
        max="127"
        value="0"
        oninput="updateThrottle(this, '<%= ip %>', '<%= engine.id %>')"
      />
      <span class="speed-value">0</span>
    </div>
  </div>

  <button class="btn" onclick="sendCmd('<%= ip %>', '<f <%= engine.id %> 0 1>')">Lights</button>
  <button class="btn" onclick="sendCmd('<%= ip %>', '<f <%= engine.id %> 1 1>')">Horn</button>
  <button class="btn red" onclick="sendCmd('<%= ip %>', '<t <%= engine.id %> 0 1>')">Stop</button>


  <details class="red-team">
    <summary>Red Team</summary>
    <div class="red-team-buttons">
      <button class="btn" onclick="attackScrambleToggle(this)">Scramble Attack</button>
      <button class="btn" onclick="attackTurboBlast()">Turbo Blast</button>
      <button class="btn" onclick="attackSlowCreep()">Slow Creep</button>
      <button class="btn" onclick="attackGhostDrift()">Ghost Drift</button>
      <button class="btn" onclick="attackRollercoaster()">Rollercoaster</button>
      <button class="btn" onclick="attackJitterBug()">Jitter Bug</button>
      <button class="btn" onclick="attackReverseSlam()">Reverse Slam</button>
      <button class="btn" onclick="attackPingPong()">Ping-Pong Attack</button>
      <button class="btn" onclick="attackEmergencyFlood()">Emergency Flood</button>
    </div>
  </details>
</div>
