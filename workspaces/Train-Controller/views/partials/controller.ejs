<div class="controller" id="controller-<%= controller.id %>">
  <button
    id="edit-controller-<%= controller.id %>"
    class="edit-ip-btn edit-controller-btn"
    onclick="toggleEditController('<%= controller.id %>')"
    title="Edit Controller"
  >🖉</button>
  <button
    id="delete-controller-<%= controller.id %>"
    class="red delete-controller-btn"
    onclick="confirmDeleteController('<%= controller.id %>')"
    title="Delete Controller"
  >Delete</button>
  <%- include('navbar', { ip: controller.ip, id: controller.id, name: controller.name }) %>

  <div class="manual-add-form" id="manual-add-form-<%= controller.id %>">
    <input type="text" id="manual-id-<%= controller.id %>" placeholder="Engine Address" />
    <input type="text" id="manual-name-<%= controller.id %>" placeholder="Name (optional)" />
    <button onclick="confirmAddEngine('<%= controller.id %>')">Add</button>
  </div>

  <div id="controls-<%= controller.id %>">
    <% engines.forEach(engine => { %>
      <%- include('engine', { engine, ip: controller.ip, controllerId: controller.id }) %>
    <% }) %>
  </div>
</div>
